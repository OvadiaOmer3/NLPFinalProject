#   01_frequency_and_forgetting.ipynb / 02_internal_paper_figures.ipynb
#       data/artifacts/recall/rotemab_15shot_top10_internal/*.parquet
#
# Everything else below is either an unused run or regenerable via
# feature_extraction/eval_checkpoints.py.
# ---------------------------------------------------------------------------

# unused recall runs
data/artifacts/recall/*.parquet
